# ---------------------------------------------------------------------------
# Employee Cab Booking - server configuration
# Copy to server/.env for local development. NEVER commit real secrets.
# In production, inject these from a secrets manager (Azure Key Vault, etc.).
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Public URL of the web app (used for links in emails and CORS)
APP_BASE_URL=http://localhost:5173

# MongoDB. Must be a replica set (transactions are required).
# Use "memory" for a local in-process replica set (dev only, data in server/.data).
MONGODB_URI=mongodb://localhost:27017/cab_booking?replicaSet=rs0

# 32+ byte random secrets. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# PIN_HMAC_KEY:     keyed hash for ride-start PIN verification
# DATA_ENCRYPTION_KEY: AES-256-GCM key (base64, exactly 32 bytes) for PIN display copy and queued email secrets
# TOKEN_HMAC_KEY:   keyed hash for session/activation/reset tokens
PIN_HMAC_KEY=change-me-dev-only-pin-hmac-key-0000000000
DATA_ENCRYPTION_KEY=ZGV2LW9ubHktZW5jcnlwdGlvbi1rZXktMzJieXRlcyE=
TOKEN_HMAC_KEY=change-me-dev-only-token-hmac-key-00000000

# Sessions
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120
# Set true behind HTTPS (required in production)
COOKIE_SECURE=false
# Number of trusted reverse proxies in front of the app (for client IPs / rate limiting)
TRUST_PROXY=0

# Email: "mock" (writes to server/.dev-mailbox), "graph" (Microsoft Graph sendMail) or "smtp" (see SMTP_* below)
EMAIL_MODE=mock
# Microsoft Graph (application permission Mail.Send, admin consented; restrict with an
# Exchange Online application access policy to the sender mailbox only)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER_MAILBOX=transport@yourcompany.com

# Microsoft Entra ID sign-in. Employees sign in ONLY with Microsoft when these are set,
# and production refuses to start without them. Leave blank for local password-only development.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Use the secret's "Value", not its "Secret ID".
# Azure client secrets expire, usually after 6, 12 or 24 months. Check the "Expires" date under
# Certificates & secrets in the Azure app and set a reminder. When it expires, every employee's
# Microsoft sign-in stops working until you add a new secret.
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:5173/api/auth/sso/callback

# Official work email domains for employees (comma separated). Blank allows any domain.
ALLOWED_EMAIL_DOMAINS=

# Background workers (outbox email sender + operational monitors)
WORKERS_ENABLED=true

# Protects GET /api/metrics (Prometheus text). Blank disables the endpoint.
METRICS_TOKEN=

LOG_LEVEL=info

# SMTP email (EMAIL_MODE=smtp). Test with: npm run test-mail -- you@company.com
# Mail server, e.g. smtp.office365.com
SMTP_HOST=
# 587 = STARTTLS (default), 465 = TLS from the start
SMTP_PORT=
# Mailbox that signs in (leave blank only if the server needs no login)
SMTP_USER=
# Its password or app password. Never commit or share it.
SMTP_PASS=
# What recipients see, e.g. "Cab Booking <noreply@company.com>"; blank = SMTP_USER
SMTP_FROM=
