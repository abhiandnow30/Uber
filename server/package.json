{
  "name": "server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:memdb": "cross-env MONGODB_URI=memory tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx src/scripts/seed.ts",
    "migrate": "tsx src/scripts/migrate.ts",
    "seed:memdb": "cross-env MONGODB_URI=memory tsx src/scripts/seed.ts",
    "test:ui": "node e2e/ui-smoke.mjs",
    "create-admin": "tsx src/scripts/create-admin.ts",
    "test-mail": "tsx src/scripts/test-mail.ts"
  },
  "dependencies": {
    "@azure/msal-node": "3.8.10",
    "cookie-parser": "1.4.7",
    "dotenv": "16.4.7",
    "exceljs": "4.4.0",
    "express": "5.1.0",
    "express-rate-limit": "7.5.1",
    "helmet": "8.3.0",
    "luxon": "3.7.2",
    "mongoose": "8.24.5",
    "nodemailer": "10.0.13",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "socket.io": "4.8.1",
    "uuid": "11.1.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/luxon": "3.7.1",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "6.0.3",
    "cross-env": "7.0.3",
    "mongodb-memory-server": "10.4.3",
    "puppeteer-core": "25.14.0",
    "socket.io-client": "4.8.1",
    "supertest": "7.1.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
